<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
      Deux profils de sortie :
        - dev (par défaut) : console lisible + fichier JSON (pour Loki)
        - prod / docker    : console JSON + fichier JSON

      Le fichier reste toujours en JSON : Promtail l'envoie tel quel à Loki,
      et un événement = une ligne (pas de stack trace éclatée en N entrées).
    -->

    <!-- Console : format lisible en développement -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Console : format structuré JSON (conteneurs / ELK) -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timeZone>UTC</timeZone>
            <customFields>{"service":"autoprime-api"}</customFields>
        </encoder>
    </appender>

    <!-- Fichier de logs structuré, tournant (10 Mo par fichier, 30 jours) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/app.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timeZone>UTC</timeZone>
            <customFields>{"service":"autoprime-api"}</customFields>
        </encoder>
    </appender>

    <!-- Production / conteneurs : console JSON -->
    <springProfile name="prod | docker">
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- Développement (profil par défaut) : console lisible -->
    <springProfile name="!prod &amp; !docker">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- Réduire le bruit des librairies tierces -->
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="io.micrometer" level="WARN"/>

</configuration>
