# Branding public — toutes les variables VITE_ sont visibles dans le bundle.
VITE_SITE_NOM=Votre marque
VITE_SITE_NOM_LONG=Votre marque automobile
VITE_SITE_BASELINE=Vente et achat de véhicules
VITE_SITE_TITRE=Votre marque — Vente de véhicules
VITE_SITE_DESCRIPTION=Découvrez notre sélection de véhicules.
VITE_SITE_MOTS_CLES=vente voiture, automobile
VITE_SITE_LOGO=/logo.svg
VITE_SITE_LOGO_INVERT=/logo-invert.svg
VITE_SITE_FAVICON=/logo.svg
VITE_TELEPHONE_FIXE=+XXX XX XX XX XX
VITE_TELEPHONE_MOBILE=+XXX XX XX XX XX
VITE_WHATSAPP=33600000000
VITE_EMAIL=contact@exemple.com
VITE_ADRESSE_RUE=Adresse
VITE_ADRESSE_VILLE=Ville
VITE_ADRESSE_PAYS=Pays
VITE_ANCIENNETE=depuis 2010
VITE_FORMSPREE_CONTACT=remplacer-par-id-formspree

# Presets de marque (showroom | electric | luxury | sport | ocean)
VITE_THEME_COLOR=showroom
# Presets typographiques (modern | editorial | technical | classic)
VITE_THEME_TYPOGRAPHY=modern
# Densité du layout (compact | balanced | spacious)
VITE_THEME_LAYOUT=balanced
# Forme des composants (rounded | soft | sharp)
VITE_THEME_RADIUS=rounded

# ── Mesure d'audience (PostHog) ──────────────────────────────────────
# Clé projet PostHog (publique, visible dans le bundle). Vide ou absente :
# aucune mesure, aucun cookie, et pas de bandeau de consentement.
# Clé récupérée dans PostHog → Project settings → Project API key.
# VITE_POSTHOG_KEY=phc_remplacer-par-la-cle-projet
#
# Hôte d'ingestion. Europe par défaut :
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
# (région US : https://us.i.posthog.com)

# ── Adresse de l'API ─────────────────────────────────────────────────
# Ne pas définir en développement : l'API est alors appelée sur
# http://localhost:8080 (valeur par défaut du front).
#
# En production (site et API sur le même domaine derrière nginx) :
#   VITE_API_URL=/
# (le navigateur appelle /api/... sur le même domaine : pas de CORS).
#
# Si l'API est sur un autre domaine :
#   VITE_API_URL=https://api.mon-domaine.fr
#
# ⚠️ Cette variable est figée au moment du build : rebuild après chaque
#    modification (pnpm build:prod pour la production).
# VITE_API_URL=/

# ── Recherche web (Exa) ──────────────────────────────────────────────
# Clé API Exa → https://dashboard.exa.ai/api-keys
# ⚠️ Pas de préfixe VITE_ : la clé reste côté outillage Node et n'est
#    jamais exposée dans le bundle du navigateur.
# Utilisée par `pnpm exa:search "votre recherche"` (scripts/exa-search.mjs).
EXA_API_KEY=
