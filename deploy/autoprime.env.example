# ==================================================================
#  /etc/autoprime/api.env — secrets de l'API AutoPrime
#  chmod 600   chown root:root
#  Ce fichier est lu par systemd (EnvironmentFile) : une ligne = une
#  variable, format CLE=valeur, SANS espace autour du "=".
#  ⚠️ Ne jamais versionner ce fichier.
# ==================================================================

# Base de données SQLite (dossier à créer : /var/lib/autoprime)
DB_PATH=/var/lib/autoprime/autoprime.db

# Port interne de l'API (derrière nginx, ne pas ouvrir au public)
PORT=8080

# Domaine public du site (sert au CORS si l'API est appelée directement)
CORS_ORIGINS=https://autoprime.example.com

# Durée d'une session admin (heures)
SESSION_HEURES=12

# Schéma de base : "update" au premier démarrage, "validate" ensuite
JPA_DDL_AUTO=update

# --- Comptes de l'espace admin ---
# Administrateur (responsable du site) : gestion du catalogue, des demandes,
# des messages. Les comptes vendeurs sont créés ensuite depuis Admin › Comptes
# avec le compte `dev` (ils ne figurent donc pas dans ce fichier).
# ⚠️ Remplacer ces valeurs avant la mise en ligne.
ADMIN_IDENTIFIANT=gerant
ADMIN_MOT_DE_PASSE=ChangezMoi2026

# Développeur : accès complet (design, informations, comptes)
DEV_IDENTIFIANT=dev
DEV_MOT_DE_PASSE=ChangezMoiDev2026
